   owl:annotatedSource obo:NCIT_C164408 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "The completed activity within the context of a given study that represents the processing of some material." ;
   obo:NCIT_P378 "NCI"
 ] .

