###  http://purl.obolibrary.org/obo/NCIT_C42614
obo:NCIT_C42614 rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/schaaar2/ontologies/2026/7/ClinOps-Core/NV_D0019
:NV_D0019 rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf obo:NCIT_C42614 ;
          rdfs:domain [ rdf:type owl:Restriction ;
                        owl:onProperty :NV_D0019 ;
                        owl:someValuesFrom xsd:string
                      ] ;
          rdfs:label "Short Name"@en .


###  http://www.semanticweb.org/schaaar2/ontologies/2026/7/ClinOps-Core/NV_D0020
:NV_D0020 rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf obo:NCIT_C42614 ;
          rdfs:label "Medium Name"@en .


###  http://www.semanticweb.org/schaaar2/ontologies/2026/7/ClinOps-Core/NV_D0021
:NV_D0021 rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf obo:NCIT_C42614 ;
          rdfs:label "Long Name"@en .


###  http://www.semanticweb.org/schaaar2/ontologies/2026/7/ClinOps-Core/NV_D0083
:NV_D0083 rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf <http://www.w3.org/2006/time#inXSDDate> ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( [ rdf:type owl:Restriction ;
                                        owl:onProperty :NV_P0087 ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :NV_C0086
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :NV_P0088 ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :NV_C0065
                                      ]
                                    )
                      ] ;
          rdfs:label "Planned Milestone Date"@en .


###  http://www.semanticweb.org/schaaar2/ontologies/2026/7/ClinOps-Core/NV_I0032
:NV_I0032 rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf <http://www.w3.org/2006/time#inXSDDate> ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( [ rdf:type owl:Restriction ;
                                        owl:onProperty :NV_P0087 ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :NV_C0086
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :NV_P0088 ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
