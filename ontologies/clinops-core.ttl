###  http://purl.obolibrary.org/obo/NCIT_C93354
obo:NCIT_C93354 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C71473 ;
                obo:IAO_0000115 "An activity that frequently occurs in studies (e.g. more than one time in more than one arm) and therefore is called out as a reusable template in a global library of activities outside the context of any particular study, and may be used in the composition of a defined study subject activity group. A defined activity is a \"kind of\" activity rather than an \"instance of\" an activity." ;
                obo:NCIT_NHC0 "C93354" ;
                obo:NCIT_P106 "Research Activity" ;
                obo:NCIT_P108 "Defined Study Activity" ;
                obo:NCIT_P207 "C2985568" ;
                obo:NCIT_P322 "BRIDG" ;
                obo:NCIT_P325 "An activity that frequently occurs in studies (e.g. more than one time in more than one arm) and therefore is called out as a reusable template in a global library of activities outside the context of any particular study, and may be used in the composition of a defined study subject activity group. A defined activity is a \"kind of\" activity rather than an \"instance of\" an activity. EXAMPLE(S): Standard blood chemistries are frequently included in studies - also activities that are study-specific and recur more than one time in more than one arm may be defined, such as a substance administration activity involving X amount of drug Y. NOTE(S): A defined activity is represented here as a subtype of Activity, but could also be thought of as an activity at a particular stage in the business process in which the activities occur, i.e., in the \"defined\" stage rather than the \"planned\" stage, the \"scheduled\" stage or the \"performed\" stage." ,
                              "An activity that frequently occurs in studies (e.g. more than one time in more than one arm) and/or experiments and therefore is called out as a reusable template in a global library of activities outside the context of any particular study or experiment, and may be used in the composition of a defined subject activity group. A defined activity is a \"kind of\" activity rather than an \"instance of\" an activity.   EXAMPLE(S): Standard blood chemistries are frequently included in studies - also activities that are study-specific and recur more than one time in more than one arm may be defined, such as a substance administration activity involving X amount of drug Y.  OTHER NAME(S):  NOTE(S): A defined activity is represented here as a subtype of Activity, but could also be thought of as an activity at a particular stage in the business process in which the activities occur, i.e., in the \"defined\" stage rather than the \"planned\" stage, the \"scheduled\" stage or the \"performed\" stage." ;
                oboInOwl:hasExactSynonym "Defined Study Activity" ,
                                         "DefinedActivity" ;
                oboInOwl:inSubset obo:NCIT_C159501 ,
                                  obo:NCIT_C159503 ;
                rdfs:label "Defined Study Activity" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:NCIT_C93354 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An activity that frequently occurs in studies (e.g. more than one time in more than one arm) and therefore is called out as a reusable template in a global library of activities outside the context of any particular study, and may be used in the composition of a defined study subject activity group. A defined activity is a \"kind of\" activity rather than an \"instance of\" an activity." ;
   obo:NCIT_P378 "NCI"
 ] .

