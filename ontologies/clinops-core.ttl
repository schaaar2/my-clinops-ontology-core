###  http://purl.obolibrary.org/obo/NCIT_C221381
obo:NCIT_C221381 rdf:type owl:Class ;
                 rdfs:subClassOf obo:NCIT_C95750 ;
                 obo:IAO_0000115 "A clinical trial that uses controls that are not participating in the main study as comparators. The controls can be individuals that receive the same treatment or be untreated, from an earlier time period (historic control) or they can from the same time period (concurrent control) but in another setting." ;
                 obo:NCIT_NHC0 "C221381" ;
                 obo:NCIT_P106 "Research Activity" ;
                 obo:NCIT_P108 "Externally Controlled Clinical Trial" ;
                 obo:NCIT_P208 "CL1954035" ;
                 obo:NCIT_P322 "FDA-NIH-MoRE" ;
                 obo:NCIT_P325 "In an externally controlled trial, outcomes in participants receiving the test treatment according to a protocol are compared to outcomes in a group of people external to the trial who had not received the same treatment. The external control arm can be a group of people, treated or untreated, from an earlier time (historical control), or it can be a group of people, treated or untreated, during the same time period (concurrent control) but in another setting." ;
                 oboInOwl:hasExactSynonym "Externally Controlled Clinical Trial" ,
                                          "Externally Controlled Trial" ;
                 oboInOwl:inSubset obo:NCIT_C220787 ;
                 rdfs:label "Externally Controlled Clinical Trial" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:NCIT_C221381 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A clinical trial that uses controls that are not participating in the main study as comparators. The controls can be individuals that receive the same treatment or be untreated, from an earlier time period (historic control) or they can from the same time period (concurrent control) but in another setting." ;
   obo:NCIT_P378 "NCI"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:NCIT_C221381 ;
   owl:annotatedProperty obo:NCIT_P325 ;
   owl:annotatedTarget "In an externally controlled trial, outcomes in participants receiving the test treatment according to a protocol are compared to outcomes in a group of people external to the trial who had not received the same treatment. The external control arm can be a group of people, treated or untreated, from an earlier time (historical control), or it can be a group of people, treated or untreated, during the same time period (concurrent control) but in another setting." ;
   obo:NCIT_P378 "FDA-NIH-MoRE"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:NCIT_C221381 ;
   owl:annotatedProperty oboInOwl:hasExactSynonym ;
   owl:annotatedTarget "Externally Controlled Clinical Trial" ;
   obo:NCIT_P383 "PT" ;
   obo:NCIT_P384 "NCI"
 ] .

