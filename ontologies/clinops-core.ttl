###  http://purl.obolibrary.org/obo/NCIT_C61410
obo:NCIT_C61410 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C54443 ;
                obo:IAO_0000115 "The terminology that includes terms relevant to the Clinical Data Interchange Standards Consortium." ;
                obo:NCIT_NHC0 "C61410" ;
                obo:NCIT_P106 "Intellectual Product" ;
                obo:NCIT_P108 "Clinical Data Interchange Standards Consortium Terminology" ;
                obo:NCIT_P207 "C1880104" ;
                obo:NCIT_P322 "CDISC" ;
                obo:NCIT_P366 "Clinical_Data_Interchange_Standards_Consortium" ;
                obo:NCIT_P372 "Yes" ;
                obo:NCIT_P376 "<p><a href=\"https://www.cdisc.org/\">Clinical Data Interchange Standards Consortium (CDISC)</a> is an international, non-profit organization that develops and supports global data standards for medical research. <a href=\"https://www.cancer.gov/cancertopics/cancerlibrary/terminologyresources/cdisc\">CDISC collaborates with EVS</a> to develop and support controlled terminology for a wide spectrum of clinical and nonclinical studies.  CDISC terminology goes through an extensive process of content development and public review before it is declared ready for release.</p><p>The value sets presented here represent the various CDISC codesets stored within the NCI Thesaurus.  These are also available for download from the <a href=\"https://evs.nci.nih.gov/ftp1/CDISC\">EVS FTP site</a>.</p>" ;
                obo:NCIT_P398 "No" ;
                oboInOwl:hasExactSynonym "CDISC" ,
                                         "CDISC Terminology" ,
                                         "Clinical Data Interchange Standards Consortium Terminology" ;
                rdfs:label "Clinical Data Interchange Standards Consortium Terminology" .

