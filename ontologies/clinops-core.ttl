###  http://purl.obolibrary.org/obo/NCIT_C221395
obo:NCIT_C221395 rdf:type owl:Class ;
                 rdfs:subClassOf obo:NCIT_C15417 ;
                 obo:IAO_0000115 "A multi-stage randomized trial where participants are randomized at two or more decision points. The decision to randomize a study participant at a later point, and which treatment options are appropriate, may be determined by their compliance and response to prior treatment." ;
                 obo:NCIT_NHC0 "C221395" ;
                 obo:NCIT_P106 "Research Activity" ;
                 obo:NCIT_P108 "Sequential Multiple Assignment Randomized Trial" ;
                 obo:NCIT_P208 "CL1954025" ;
                 obo:NCIT_P322 "FDA-NIH-MoRE" ;
                 obo:NCIT_P325 "A trial designed to evaluate a collection of interventions guided by a sequence of decision rules that specifies when and how the type and/or intensity of an intervention should be modified, depending on the patient's past or present characteristics and/or ongoing clinical state or performance (eg, response, adherence), to optimize clinically important outcomes. In such a trial, patients move along multiple stages and are randomly assigned to one of several suitable intervention options at each stage." ;
                 oboInOwl:hasExactSynonym "SMART" ,
                                          "Sequential Multiple Assignment Randomized Trial" ,
                                          "Sequential, Multiple Assignment, Randomized Trial (SMART)" ;
                 oboInOwl:inSubset obo:NCIT_C220787 ;
                 rdfs:label "Sequential Multiple Assignment Randomized Trial" .

