obo:NCIT_C15417 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C208219 ;
                obo:IAO_0000115 "Assignment of subjects by chance to groups that receive different treatments." ;
                obo:NCIT_NHC0 "C15417" ;
                obo:NCIT_P106 "Research Activity" ;
                obo:NCIT_P108 "Randomized Clinical Trial" ;
                obo:NCIT_P207 "C0206034" ;
                obo:NCIT_P322 "PCDC" ;
                obo:NCIT_P325 "A study in which the participants are assigned by chance to separate groups that compare different treatments; neither the researchers nor the participants can choose which group. Using chance to assign people to groups means that the groups will be similar and that the treatments they receive can be compared objectively. At the time of the trial, it is not known which treatment is best. It is the patient's choice to be in a randomized trial." ;
                obo:NCIT_P366 "Randomized_Clinical_Trial" ;
                oboInOwl:hasExactSynonym "Randomized" ,
                                         "Randomized Clinical Trial" ,
