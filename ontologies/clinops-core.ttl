###  http://purl.obolibrary.org/obo/NCIT_C203568
obo:NCIT_C203568 rdf:type owl:Class ;
                 rdfs:subClassOf obo:NCIT_C203558 ;
                 obo:IAO_0000115 "Patients randomized with the following course sequence: 1) Chemoradiotherapy: Patients undergo radiation therapy once daily (QD) five days a week for 6 weeks. Patients also receive vincristine sulfate intravenously (IV) over 1 minute once weekly for 6 weeks. Six weeks after completion of chemoradiotherapy, patients proceed to maintenance therapy, 2) Maintenance Therapy: Patients receive cisplatin IV over 6 hours on day 1, vincristine sulfate IV over 1 minute on days 1 and 8, and cyclophosphamide IV over 1 hour on days 2 and 3. Patients also receive filgrastim subcutaneously (SC) or IV beginning on day 4 and continuing until blood counts recover (at least 10 days). Treatment repeats every 28 days for a total of 6 courses in the absence of disease progression or unacceptable toxicity. (Leary SES, et al. JAMA Oncol. 2021 Sep 1;7(9):1313-1321.)" ;
                 obo:NCIT_NHC0 "C203568" ;
                 obo:NCIT_P106 "Research Activity" ;
                 obo:NCIT_P108 "ACNS0332 Arm A" ;
                 obo:NCIT_P208 "CL1922447" ;
                 oboInOwl:hasExactSynonym "ACNS0332 Arm A" ,
                                          "ACNS0332:Arm A" ;
                 rdfs:label "ACNS0332 Arm A" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:NCIT_C203568 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "Patients randomized with the following course sequence: 1) Chemoradiotherapy: Patients undergo radiation therapy once daily (QD) five days a week for 6 weeks. Patients also receive vincristine sulfate intravenously (IV) over 1 minute once weekly for 6 weeks. Six weeks after completion of chemoradiotherapy, patients proceed to maintenance therapy, 2) Maintenance Therapy: Patients receive cisplatin IV over 6 hours on day 1, vincristine sulfate IV over 1 minute on days 1 and 8, and cyclophosphamide IV over 1 hour on days 2 and 3. Patients also receive filgrastim subcutaneously (SC) or IV beginning on day 4 and continuing until blood counts recover (at least 10 days). Treatment repeats every 28 days for a total of 6 courses in the absence of disease progression or unacceptable toxicity. (Leary SES, et al. JAMA Oncol. 2021 Sep 1;7(9):1313-1321.)" ;
   obo:NCIT_P378 "NCI"
 ] .

