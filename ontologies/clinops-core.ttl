   owl:annotatedSource obo:NCIT_C70665 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A living individual about whom an investigator conducting research obtains data through intervention or interaction with the individual or through identifiable private information." ;
   obo:NCIT_P378 "NCI"
 ] .

