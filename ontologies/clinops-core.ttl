###  http://purl.obolibrary.org/obo/NCIT_C53312
obo:NCIT_C53312 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C15273 ;
                obo:IAO_0000115 "A study in which participants with known outcomes are assessed based on data collected before the study." ;
                obo:NCIT_NHC0 "C53312" ;
                obo:NCIT_P106 "Research Activity" ;
                obo:NCIT_P108 "Retrospective Study" ;
                obo:NCIT_P207 "C0035363" ;
                obo:NCIT_P322 "CDISC" ,
                              "CDISC-GLOSS" ,
                              "MRCT-Ctr" ;
                obo:NCIT_P325 "A study that compares two groups of people: those with the disease or condition under study (cases) and a very similar group of people who do not have the disease or condition (controls). Researchers study the medical and lifestyle histories of the people in each group to learn what factors may be associated with the disease or condition. For example, one group may have been exposed to a particular substance that the other was not." ,
                              "A study with planned observations collected predominantly before study start (i.e., backward-looking). (CDISC Glossary)" ,
                              "A study with planned observations collected predominantly before study start (i.e., backward-looking). NOTE: Examples are case-control studies or retrospective cohort studies when the observations from the selected subjects occurred before study start. [After ClinicalTrials.gov] See also prospective study, observational study, adaptive design, clinical study." ,
                              "Research that uses already existing data. (https://mrctcenter.org/glossaryterm/retrospective-study/)" ;
                obo:NCIT_P366 "Retrospective_Study" ;
                oboInOwl:hasExactSynonym "RETROSPECTIVE" ,
                                         "Retrospective Study" ,
                                         "retrospective study" ;
                oboInOwl:inSubset obo:NCIT_C127261 ,
                                  obo:NCIT_C203912 ,
                                  obo:NCIT_C61410 ,
                                  obo:NCIT_C66830 ,
                                  obo:NCIT_C67497 ;
                rdfs:label "Retrospective Study" .

