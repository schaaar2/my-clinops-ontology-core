###  http://purl.obolibrary.org/obo/NCIT_C15197
obo:NCIT_C15197 rdf:type owl:Class ;
                rdfs:subClassOf obo:NCIT_C16084 ;
                obo:IAO_0000115 "A study that compares two groups of people: those with the disease or condition under study (cases) and a very similar group of people who do not have the disease or condition (controls). Researchers study the medical and lifestyle histories of the people in each group to learn what factors may be associated with the disease or condition. For example, one group may have been exposed to a particular substance that the other was not. Also called retrospective study." ;
                obo:NCIT_NHC0 "C15197" ;
                obo:NCIT_P106 "Research Activity" ;
                obo:NCIT_P108 "Case-Control Study" ;
                obo:NCIT_P207 "C0007328" ;
                obo:NCIT_P322 "CDISC" ,
                              "CDISC-GLOSS" ,
                              "MRCT-Ctr" ,
                              "SeroNet" ;
                obo:NCIT_P325 "A study in which individuals to an outcome (cases) are compared with those who do not have the outcome (controls). NOTE: The outcome variable (disease, event, experience, biomarker) is chosen first, and the exposure is evaluated in cases vs controls to see whether there is an association between exposure and outcome. [After AMA Manual of Style] See also outcome, observational study." ,
                              "A study that compares two groups of people: those with the disease or condition under study (cases) and a very similar group of people who do not have the disease or condition (controls). Researchers study the medical and lifestyle histories of the people in each group to learn what factors may be associated with the disease or condition. For example, one group may have been exposed to a particular substance that the other was not. Also called retrospective study." ,
                              "Research that uses existing data to compare a group of participants with a disease or trait to a group without the same disease or trait. (https://mrctcenter.org/glossaryterm/case-control-study/)" ,
                              "Retrospective study in which individuals with an outcome (cases) are compared to those who do not have the outcome (controls). (CDISC Glossary)" ;
                obo:NCIT_P366 "Case-Control_Study" ;
                oboInOwl:hasExactSynonym "CASE CONTROL" ,
                                         "Case-Control Study" ,
                                         "case-control study" ;
                oboInOwl:inSubset obo:NCIT_C127259 ,
                                  obo:NCIT_C132298 ,
                                  obo:NCIT_C179027 ,
                                  obo:NCIT_C189083 ,
                                  obo:NCIT_C203912 ,
                                  obo:NCIT_C61410 ,
                                  obo:NCIT_C66830 ,
                                  obo:NCIT_C67497 ;
                rdfs:label "Case-Control Study" .

