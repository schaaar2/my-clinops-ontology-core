                 obo:NCIT_P106 "Research Activity" ;
                 obo:NCIT_P108 "Target Trial Emulation" ;
                 obo:NCIT_P208 "CL1954023" ;
                 obo:NCIT_P322 "FDA-NIH-MoRE" ;
                 obo:NCIT_P325 "A framework for designing and analyzing an observational study based on conceptualizing a target randomized trial to answer a scientific question and designing the observational study to mimic the trial estimand(s) (including specification of population eligibility criteria, treatment strategies and assignment procedures, outcomes, handling of intercurrent events, and follow-up period)." ;
                 oboInOwl:hasExactSynonym "Target Trial Emulation" ;
                 oboInOwl:inSubset obo:NCIT_C220787 ;
                 rdfs:label "Target Trial Emulation" .

