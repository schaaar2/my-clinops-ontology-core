gdmt:sponsor rdf:type owl:AnnotationProperty ;
             dct:title "Sponsor" ;
             rdfs:label "sponsor" .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Biomarker
clinops-ref:Biomarker rdf:type owl:NamedIndividual ,
                               skos:Concept ,
                               clinops:OutcomeComponentType ;
                      rdfs:label "biomarker" ;
                      skos:definition "defined characteristic that is measured as an indicator of normal biological processes, pathogenic processes, or responses to an exposure or intervention, including therapeutic interventions" ;
                      cmns-av:directSource "https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&ns=ncit&code=C16342" ;
                      cmns-av:explanatoryNote "Molecular, histologic, radiographic, or physiologic characteristics are types of biomarkers. A biomarker is not an assessment of how an individual feels, functions, or survives. Categories of biomarkers include: susceptibility/risk biomarker; diagnostic biomarker; monitoring biomarker; prognostic biomarker; predictive biomarker; safety biomarker; pharmacodynamic/response biomarker." .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Efficacy
clinops-ref:Efficacy rdf:type owl:NamedIndividual ,
                              skos:Concept ,
                              clinops:OutcomeComponentType ;
                     rdfs:label "efficacy" ;
                     skos:definition "measure of intended effect on the disease or condition based on adequate and well-controlled clinical trials" ;
                     cmns-av:directSource "https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&ns=ncit&code=C88183" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Pharmacokinetic
clinops-ref:Pharmacokinetic rdf:type owl:NamedIndividual ,
                                     skos:Concept ,
                                     clinops:OutcomeComponentType ;
                            rdfs:label "pharmacokinetic" ;
                            skos:definition "study of the process by which a drug is absorbed, distributed, metabolized, and eliminated by the body" ;
                            cmns-av:directSource "https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&ns=ncit&code=C49663" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Phase0Trial
clinops-ref:Phase0Trial rdf:type owl:NamedIndividual ,
                                 skos:Concept ,
                                 clinops:TrialPhase ;
                        rdfs:label "phase 0 trial" ;
                        skos:definition "first-in-human trial with a small number of subjects that is conducted before a Phase 1 trial and is intended to assess new candidate therapeutic and imaging agents" ;
                        cmns-av:adaptedFrom "USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]" ;
                        cmns-av:explanatoryNote "The study agent is administered at a low dose for a limited time, and there is no therapeutic or diagnostic intent. NOTE: FDA Guidance for Industry, Investigators, and Reviewers: Exploratory IND Studies, January 2006 classifies such studies as Phase 1. NOTE: A Phase 0 study might not include any drug delivery but may be an exploration of human material from a study (e.g., tissue samples or biomarker determinations). [Improving the Quality of Cancer Clinical Trials: Workshop summary-Proceedings of the National Cancer Policy Forum Workshop, improving the Quality of Cancer Clinical Trials (Washington, DC, Oct 2007)] (CDISC glossary)" ;
                        cmns-av:synonym "pre-clinical trial" ,
                                        "trial phase 0" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIITrial
clinops-ref:PhaseIIITrial rdf:type owl:NamedIndividual ,
                                   skos:Concept ,
                                   clinops:TrialPhase ;
                          rdfs:label "phase III trial" ;
                          skos:definition "expanded controlled and uncontrolled trial that is performed after preliminary evidence suggesting effectiveness of the drug has been obtained, and is intended to gather the additional information about effectiveness and safety that is needed to confirm efficacy and evaluate the overall benefit-risk relationship of the drug and to provide an adequate basis for physician labeling" ;
                          cmns-av:directSource "https://ncim.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI MetaThesaurus&code=C0282461" ;
                          cmns-av:explanatoryNote "Phase 3 studies usually include from several hundred to several thousand subjects. [After FDA CDER Handbook, ICH E8] (CDISC glossary)" ;
                          cmns-av:synonym "phase 3 trial" ,
                                          "trial phase 3" ,
                                          "trial phase III" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIIaTrial
clinops-ref:PhaseIIIaTrial rdf:type owl:NamedIndividual ,
                                    skos:Concept ,
                                    clinops:TrialPhase ;
                           skos:broader clinops-ref:PhaseIIITrial ;
                           rdfs:label "phase IIIa trial" ;
                           skos:definition "classification typically assigned retrospectively to a Phase III trial upon determination by regulatory authorities of a need for a Phase III B trial" ;
                           cmns-av:directSource "https://ncim.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI Metathesaurus&code=C1706447" ;
                           cmns-av:synonym "phase 3a trial" ,
                                           "trial phase 3a" ,
                                           "trial phase IIIa" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIIbTrial
clinops-ref:PhaseIIIbTrial rdf:type owl:NamedIndividual ,
                                    skos:Concept ,
                                    clinops:TrialPhase ;
                           skos:broader clinops-ref:PhaseIIITrial ;
                           rdfs:label "phase IIIb trial" ;
                           skos:definition "subcategory of Phase III trials done near the time of approval to elicit additional findings" ;
                           cmns-av:directSource "USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]" ;
                           cmns-av:explanatoryNote "Dossier review may continue while associated Phase IIIB trials are conducted. These trials may be required as a condition of regulatory authority approval." ;
                           cmns-av:synonym "phase 3b trial" ,
                                           "trial phase 3b" ,
                                           "trial phase IIIb" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIITrial
clinops-ref:PhaseIITrial rdf:type owl:NamedIndividual ,
                                  skos:Concept ,
                                  clinops:TrialPhase ;
                         rdfs:label "phase II trial" ;
                         skos:definition "controlled clinical study conducted to evaluate the effectiveness of the drug for a particular indication or indications in patients with the disease or condition under study and to determine the common short-term side effects and risks associated with the drug" ;
                         cmns-av:directSource "USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]" ;
                         cmns-av:explanatoryNote "NOTE: Phase 2 studies are typically well controlled, closely monitored, and conducted in a relatively small number of patients, usually involving no more than several hundred subjects. [After FDA CDER Handbook, ICH E8] (CDISC glossary)" ;
                         cmns-av:synonym "phase 2 trial" ,
                                         "trial phase 2" ,
                                         "trial phase II" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIaTrial
clinops-ref:PhaseIIaTrial rdf:type owl:NamedIndividual ,
                                   skos:Concept ,
                                   clinops:TrialPhase ;
                          skos:broader clinops-ref:PhaseIITrial ;
                          rdfs:label "phase IIa trial" ;
                          skos:definition "clinical research protocol generally referred to as a pilot or feasibility trial that aims to prove the concept of the new intervention in question (NCI)" ;
                          cmns-av:directSource "https://ncim.nci.nih.gov/ncimbrowser/pages/concept_details.jsf?dictionary=NCI MetaThesaurus&code=C1706446&type=properties" ;
                          cmns-av:synonym "phase 2a trial" ,
                                          "trial phase 2a" ,
                                          "trial phase IIa" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIbTrial
clinops-ref:PhaseIIbTrial rdf:type owl:NamedIndividual ,
                                   skos:Concept ,
                                   clinops:TrialPhase ;
                          skos:broader clinops-ref:PhaseIITrial ;
                          rdfs:label "phase IIb trial" ;
                          skos:definition "clinical research protocol generally referred to as a well-controlled and pivotal trial that aims to prove the mechanism of action of the new intervention in question" ;
                          cmns-av:directSource "USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]" ;
                          cmns-av:explanatoryNote "A pivotal study will generally be well-controlled, randomized, of adequate size, and whenever possible, double-blind. (NCI)" ;
                          cmns-av:synonym "phase 2b trial" ,
                                          "trial phase 2b" ,
                                          "trial phase IIb" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseITrial
clinops-ref:PhaseITrial rdf:type owl:NamedIndividual ,
                                 skos:Concept ,
                                 clinops:TrialPhase ;
                        rdfs:label "phase I trial" ;
                        skos:definition "initial introduction of an investigational new drug into humans" ;
                        cmns-av:directSource "USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]" ;
                        cmns-av:explanatoryNote "Phase 1 studies are typically closely monitored and may be conducted in patients or normal volunteer subjects. NOTE: These studies are designed to determine the metabolism and pharmacologic actions of the drug in humans, the side effects associated with increasing doses, and, if possible, to gain early evidence on effectiveness. During Phase 1, sufficient information about the drug's pharmacokinetics and pharmacological effects should be obtained to permit the design of well-controlled, scientifically valid, Phase 2 studies. The total number of subjects and patients included in Phase I studies varies with the drug, but is generally in the range of 20 to 80. Phase 1 studies also include studies of drug metabolism, structure-activity relationships, and mechanism of action in humans, as well as studies in which investigational drugs are used as research tools to explore biological phenomena or disease processes. [After FDA CDER Handbook, ICH E8] (CDISC glossary)" ;
                        cmns-av:synonym "trial phase 1" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIVTrial
clinops-ref:PhaseIVTrial rdf:type owl:NamedIndividual ,
                                  skos:Concept ,
                                  clinops:TrialPhase ;
                         rdfs:label "phase IV trial" ;
                         skos:definition "post-approval study to delineate additional information about the drug's risks, benefits, and optimal use that may be requested by regulatory authorities in conjunction with marketing approval" ;
                         cmns-av:directSource "USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]" ;
                         cmns-av:explanatoryNote "Phase 4 studies could include, but would not be limited to, studying different doses or schedules of administration than were used in Phase 2 studies, use of the drug in other patient populations or other stages of the disease, or use of the drug over a longer period of time. [after FDA CDER handbook, ICH E8] See also phase." ;
                         cmns-av:synonym "phase 4 trial" ,
                                         "trial phase 4" ,
                                         "trial phase IV" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseVTrial
clinops-ref:PhaseVTrial rdf:type owl:NamedIndividual ,
                                 skos:Concept ,
                                 clinops:TrialPhase ;
                        rdfs:label "phase V trial" ;
                        skos:definition "postmarketing surveillance to monitor product safety and efficacy" ;
                        cmns-av:directSource "USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]" ;
                        cmns-av:synonym "phase 5 trial" ,
                                        "trial phase 5" ,
                                        "trial phase V" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PrimaryEndpoint
clinops-ref:PrimaryEndpoint rdf:type owl:NamedIndividual ,
                                     skos:Concept ,
                                     clinops:StudyEndpointLevel ;
                            rdfs:label "primary endpoint" ;
                            skos:definition "main result that is measured at the end of a study to see if a given treatment worked (e.g., the number of deaths or the difference in survival between the treatment group and the control group)" ;
                            cmns-av:directSource "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C94496" ;
                            cmns-av:explanatoryNote "What the primary endpoint will be is decided before the study begins. Endpoint(s) of greatest importance that is the basis for concluding whether the study met its objective(s) and provides a clinically relevant, valid, and reliable measure of the primary objective(s). (After FDA-NIH Protocol Template)" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PrimaryObjective
clinops-ref:PrimaryObjective rdf:type owl:NamedIndividual ,
                                      skos:Concept ,
                                      clinops:StudyObjectiveLevel ;
                             rdfs:label "primary objective" ;
                             skos:definition "main question to be answered and drives any statistical planning for the trial (e.g., calculation of the sample size to provide the appropriate power for statistical testing)[ICH E6 6.3]" ;
                             cmns-av:abbreviation "OBJPRIM" ;
                             cmns-av:directSource "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C85826" ;
                             cmns-av:explanatoryNote "A principle objective of the study." ;
                             cmns-av:synonym "study primary objective" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Safety
clinops-ref:Safety rdf:type owl:NamedIndividual ,
                            skos:Concept ,
                            clinops:OutcomeComponentType ;
                   rdfs:label "safety" ;
                   skos:definition "relative freedom from harm" ;
                   cmns-av:directSource "https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&ns=ncit&code=C60828" ;
                   cmns-av:explanatoryNote "In clinical trials, this refers to an absence of harmful side effects resulting from use of the product and may be assessed by laboratory testing of biological samples, special tests and procedures, psychiatric evaluation, and/or physical examination of subjects." .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/SecondaryEndpoint
clinops-ref:SecondaryEndpoint rdf:type owl:NamedIndividual ,
                                       skos:Concept ,
                                       clinops:StudyEndpointLevel ;
                              rdfs:label "secondary endpoint" ;
                              skos:definition "endpoint(s) that may provide supportive information about the effect of the study intervention(s) on the primary endpoint or demonstrate additional effects on the disease or condition (After FDA-NIH Protocol Template)" ;
                              cmns-av:directSource "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139173" .


###  https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/SecondaryObjective
clinops-ref:SecondaryObjective rdf:type owl:NamedIndividual ,
                                        skos:Concept ,
                                        clinops:StudyObjectiveLevel ;
                               rdfs:label "secondary objective" ;
                               skos:definition "supportive or ancillary questions of interest in a trial that will provide further information on the use of the treatment" ;
                               cmns-av:abbreviation "OBJSEC" ;
                               cmns-av:directSource "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C85827" ;
                               cmns-av:explanatoryNote "An auxiliary objective of the study." ;
                               cmns-av:synonym "study secondary objective" .


