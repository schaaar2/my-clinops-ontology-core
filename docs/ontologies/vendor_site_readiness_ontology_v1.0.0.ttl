    rdfs:label "System access assignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass vsr:VendorSystem ;
            owl:onProperty vsr:grantsAccessTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:AccessStatus ;
            owl:onProperty vsr:hasAccessStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:SiteVendorServiceAssignment ;
            owl:onProperty vsr:accessForAssignment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:Person ;
            owl:onProperty vsr:assignedToPerson ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        vsr:Assignment .

vsr:DecisionStatus a owl:Class ;
    rdfs:label "Decision status"@en ;
    rdfs:subClassOf vsr:Status ;
