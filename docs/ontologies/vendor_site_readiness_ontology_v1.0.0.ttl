    owl:distinctMembers ( vsr:AssignmentProposed vsr:AssignmentPending vsr:AssignmentConfirmed vsr:AssignmentActive vsr:AssignmentSuspended vsr:AssignmentTerminated vsr:AssignmentCompleted ) .

