        [ a owl:Restriction ;
            owl:onClass vsr:TrainingStatus ;
            owl:onProperty vsr:hasTrainingStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:Person ;
            owl:onProperty vsr:assignedToPerson ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:TrainingCourse ;
            owl:onProperty vsr:assignedTraining ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        vsr:Assignment .

vsr:VendorOrganization a owl:Class ;
    rdfs:label "Vendor organization"@en ;
    rdfs:subClassOf vsr:Organization .

vsr:ActivityStatus a owl:Class ;
    rdfs:label "Activity status"@en ;
    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:NotStarted vsr:Planned vsr:InProgress vsr:Waiting vsr:Blocked vsr:Completed vsr:Cancelled vsr:NotApplicable ) .

vsr:AssignmentStatus a owl:Class ;
    rdfs:label "Assignment status"@en ;
    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:AssignmentProposed vsr:AssignmentPending vsr:AssignmentConfirmed vsr:AssignmentActive vsr:AssignmentSuspended vsr:AssignmentTerminated vsr:AssignmentCompleted ) .

vsr:Document a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:subClassOf vsr:Artifact .

vsr:EquipmentStatus a owl:Class ;
    rdfs:label "Equipment status"@en ;
    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:EquipmentNotRequired vsr:EquipmentRequired vsr:EquipmentOrdered vsr:EquipmentDelivered vsr:EquipmentInstalled vsr:EquipmentQualificationPending vsr:EquipmentQualified vsr:EquipmentQualificationFailed vsr:EquipmentCertificationExpired ) .

vsr:EvidenceStatus a owl:Class ;
    rdfs:label "Evidence status"@en ;
    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:EvidenceMissing vsr:EvidenceSubmitted vsr:EvidenceUnderReview vsr:EvidenceAccepted vsr:EvidenceRejected vsr:EvidenceExpired vsr:EvidenceSuperseded ) .

vsr:RequirementEvaluationStatus a owl:Class ;
    rdfs:label "Requirement evaluation status"@en ;
    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:NotEvaluated vsr:RequirementPending vsr:RequirementSatisfied vsr:RequirementNotSatisfied vsr:RequirementConditionallySatisfied vsr:RequirementWaived vsr:RequirementNotApplicable ) .

vsr:AccessStatus a owl:Class ;
    rdfs:label "Access status"@en ;
    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:AccessNotRequested vsr:AccessRequested vsr:AccessPending vsr:AccessProvisioned vsr:AccessVerified vsr:AccessFailed vsr:AccessRevoked vsr:AccessNotApplicable ) .

vsr:ClinicalStudy a owl:Class ;
    rdfs:label "Clinical study"@en ;
    rdfs:subClassOf vsr:BusinessEntity .

vsr:RequirementAssignment a owl:Class ;
    rdfs:label "Requirement assignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom vsr:Rule ;
            owl:onProperty vsr:governedByRule ],
        [ a owl:Restriction ;
            owl:onClass vsr:SiteVendorServiceAssignment ;
            owl:onProperty vsr:assignmentFor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:Requirement ;
            owl:onProperty vsr:instantiatesRequirement ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom vsr:RequirementEvaluation ;
            owl:onProperty vsr:evaluatedBy ],
        vsr:Assignment .

vsr:RequirementEvaluation a owl:Class ;
    rdfs:label "Requirement evaluation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass vsr:RequirementEvaluationStatus ;
            owl:onProperty vsr:hasEvaluationStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:RequirementAssignment ;
            owl:onProperty vsr:evaluatesRequirementAssignment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom vsr:ReadinessEvidence ;
            owl:onProperty vsr:supportedByEvidence ],
        vsr:Assessment .

vsr:ShipmentStatus a owl:Class ;
    rdfs:label "Shipment status"@en ;
    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:ShipmentNotInitiated vsr:ShipmentPlanned vsr:ShipmentDispatched vsr:ShipmentInTransit vsr:ShipmentDelayed vsr:ShipmentDelivered vsr:ShipmentAcknowledged vsr:ShipmentCancelled ) .

vsr:TrainingStatus a owl:Class ;
