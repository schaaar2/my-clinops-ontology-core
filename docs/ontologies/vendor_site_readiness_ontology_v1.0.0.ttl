    rdfs:label "Role"@en .

vsr:Milestone a owl:Class ;
    rdfs:label "Milestone"@en ;
    rdfs:subClassOf vsr:Event .

vsr:ProvenanceEntity a owl:Class ;
    rdfs:label "Provenance entity"@en .

vsr:ReadinessAssessment a owl:Class ;
    rdfs:label "Readiness assessment"@en ;
    rdfs:subClassOf vsr:Assessment .

vsr:Assessment a owl:Class ;
    rdfs:label "Assessment"@en .

vsr:Assignment a owl:Class ;
    rdfs:label "Assignment"@en .

vsr:Equipment a owl:Class ;
    rdfs:label "Equipment"@en ;
    rdfs:subClassOf vsr:BusinessEntity .

vsr:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf vsr:Party .

vsr:StudySite a owl:Class ;
    rdfs:label "Study site"@en ;
    rdfs:subClassOf vsr:BusinessEntity ;
    vsr:definition "Study-specific participation of a reusable clinical facility."@en .

vsr:Rule a owl:Class ;
    rdfs:label "Rule"@en .

vsr:Shipment a owl:Class ;
    rdfs:label "Shipment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass vsr:SiteVendorServiceAssignment ;
            owl:onProperty vsr:shipmentForAssignment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass vsr:ShipmentItem ;
            owl:onProperty vsr:containsShipmentItem ],
        [ a owl:Restriction ;
            owl:onClass vsr:ShipmentStatus ;
            owl:onProperty vsr:hasShipmentStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:VendorOrganization ;
            owl:onProperty vsr:initiatedByVendor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        vsr:BusinessEntity .

vsr:Status a owl:Class ;
    rdfs:label "Status"@en .

vsr:VendorService a owl:Class ;
    rdfs:label "Vendor service"@en ;
    rdfs:subClassOf vsr:Capability ;
    vsr:definition "Readiness is evaluated for an assigned vendor service, not for a vendor globally."@en .

vsr:Risk a owl:Class ;
    rdfs:label "Risk"@en .

vsr:ReadinessEvidence a owl:Class ;
    rdfs:label "Readiness evidence"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass vsr:EvidenceStatus ;
            owl:onProperty vsr:hasEvidenceStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass vsr:Artifact ;
            owl:onProperty vsr:derivedFromArtifact ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass vsr:RequirementAssignment ;
            owl:onProperty vsr:providedForRequirement ],
        vsr:Artifact ;
    vsr:definition "Evidence supports a requirement evaluation and retains source lineage."@en .

vsr:SiteVendorServiceAssignment a owl:Class ;
    rdfs:label "Site vendor service assignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass vsr:ClinicalStudy ;
            owl:onProperty vsr:forStudy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:AssignmentStatus ;
            owl:onProperty vsr:hasAssignmentStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom vsr:ReadinessDecision ;
            owl:onProperty vsr:hasReadinessDecision ],
        [ a owl:Restriction ;
            owl:allValuesFrom vsr:RequirementAssignment ;
            owl:onProperty vsr:hasRequirementAssignment ],
        [ a owl:Restriction ;
            owl:allValuesFrom vsr:AssignmentReadinessAssessment ;
            owl:onProperty vsr:hasReadinessAssessment ],
        [ a owl:Restriction ;
            owl:onClass vsr:VendorOrganization ;
            owl:onProperty vsr:assignsVendor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:VendorService ;
            owl:onProperty vsr:assignsVendorService ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:StudySite ;
            owl:onProperty vsr:forStudySite ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        vsr:Assignment ;
    owl:hasKey ( vsr:forStudy vsr:forStudySite vsr:assignsVendor vsr:assignsVendorService vsr:assignmentStartDate ) ;
    vsr:definition "Canonical readiness anchor at study + study site + vendor + vendor service + effective period."@en ;
    vsr:implementationNote "Enterprise namespace registration, source-to-semantic mapping, SHACL validation and representative-data testing are required before controlled production deployment."@en .

vsr:Activity a owl:Class ;
    rdfs:label "Activity"@en .

vsr:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    vsr:definition "Applicability can depend on protocol version, service, country, site, role and effective period."@en .

vsr:BusinessEntity a owl:Class ;
    rdfs:label "Business entity"@en .

