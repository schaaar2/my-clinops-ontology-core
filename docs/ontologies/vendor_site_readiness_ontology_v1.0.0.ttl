vsr:ReadinessDecision a owl:Class ;
    rdfs:label "Readiness decision"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass vsr:Party ;
            owl:onProperty vsr:decidedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:ReadinessAssessment ;
            owl:onProperty vsr:basedOnAssessment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:SiteVendorServiceAssignment ;
            owl:onProperty vsr:decisionForAssignment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass vsr:ReadinessStatus ;
            owl:onProperty vsr:resultsInReadinessStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        vsr:Decision ;
    vsr:definition "Final readiness is represented by an accountable decision; absence of gaps alone is not approval."@en .

