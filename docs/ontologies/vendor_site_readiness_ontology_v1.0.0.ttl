    rdfs:subClassOf vsr:Status ;
    owl:oneOf ( vsr:TrainingNotAssigned vsr:TrainingAssigned vsr:TrainingInProgress vsr:TrainingCompleted vsr:TrainingFailed vsr:TrainingExpired vsr:TrainingWaived vsr:TrainingNotApplicable ) .

