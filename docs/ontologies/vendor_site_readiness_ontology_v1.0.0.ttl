    owl:distinctMembers ( vsr:TrainingNotAssigned vsr:TrainingAssigned vsr:TrainingInProgress vsr:TrainingCompleted vsr:TrainingFailed vsr:TrainingExpired vsr:TrainingWaived vsr:TrainingNotApplicable ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( vsr:NotEvaluated vsr:RequirementPending vsr:RequirementSatisfied vsr:RequirementNotSatisfied vsr:RequirementConditionallySatisfied vsr:RequirementWaived vsr:RequirementNotApplicable ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( vsr:RiskOpen vsr:RiskMitigating vsr:RiskAccepted vsr:RiskClosed ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vsr:ClinicalStudy vsr:StudySite vsr:VendorOrganization vsr:VendorService vsr:Requirement vsr:ReadinessEvidence vsr:Activity vsr:Assessment vsr:Decision vsr:Status ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( vsr:QualificationNotStarted vsr:QualificationPending vsr:QualificationApproved vsr:QualificationRejected vsr:QualificationExpired ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( vsr:DecisionDraft vsr:DecisionPendingReview vsr:DecisionApproved vsr:DecisionRejected vsr:DecisionOverridden vsr:DecisionWithdrawn ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vsr:Person vsr:Organization ) .

