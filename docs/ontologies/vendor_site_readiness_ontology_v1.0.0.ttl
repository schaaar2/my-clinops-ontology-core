vsr:AcknowledgedShipment a owl:Class ;
    rdfs:label "Acknowledged shipment"@en ;
    rdfs:subClassOf vsr:Shipment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vsr:Shipment [ a owl:Restriction ;
                        owl:hasValue vsr:ShipmentAcknowledged ;
                        owl:onProperty vsr:hasShipmentStatus ] ) ] .

