@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vsr: <https://data.novartis.com/ontology/vendor-site-readiness/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://data.novartis.com/ontology/vendor-site-readiness> a owl:Ontology ;
    dcterms:created "2026-09-30"^^xsd:date ;
    dcterms:description "Protocol-driven ontology for vendor-service readiness at clinical study sites, covering assignments, requirements, personnel, access, training, plans, activities, logistics, equipment, evidence, assessments, risks, decisions, recommendations, provenance and auditability."@en ;
    dcterms:title "Vendor Site Readiness Ontology"@en ;
    rdfs:comment "Production-oriented semantic baseline. Closed-world validation, arithmetic, temporal comparison and completeness rules are delegated to SHACL or application logic."@en ;
    owl:versionIRI vsr:1.0.0 ;
    owl:versionInfo "1.0.0" ;
    vsr:businessRule "Absence of an evidence triple is not proof of missing evidence; use SHACL against a declared closed data scope."@en,
        "Calculated readiness and human-approved readiness are distinct."@en,
        "Delivered is not shipment-ready until required items are reconciled and receipt is acknowledged."@en,
        "Evidence must be accepted, current, unexpired and linked to the correct assignment and requirement."@en,
        "Protocol amendments trigger reassessment of applicability, plans, evidence, assessments and decisions."@en,
        "Ready requires all applicable mandatory requirements satisfied or validly waived, all blocking findings closed, and an authorized approved decision."@en ;
    vsr:competencyQuestion "What blocks SIV or Ready-to-Screen?"@en,
        "What evidence and source records support the readiness decision?"@en,
        "What next action is recommended, for whom and why?"@en,
        "Which equipment requires installation, qualification or certification?"@en,
        "Which mandatory requirements are unsatisfied or lack acceptable evidence?"@en,
        "Which personnel require training or vendor-system access?"@en,
        "Which protocol-derived requirements apply to each assignment?"@en,
        "Which shipments are delayed, delivered or awaiting acknowledgement?"@en,
        "Which vendor services are assigned to a study site?"@en,
        "Who approved the decision and what rationale was recorded?"@en .

vsr:AccessGrantedMilestone a owl:Class ;
    rdfs:label "Access granted milestone"@en ;
    rdfs:subClassOf vsr:Milestone .

vsr:AccessProvision a owl:Class ;
    rdfs:label "Access provision"@en ;
    rdfs:subClassOf vsr:SystemAccess .

