        [ a owl:Restriction ;
            owl:onClass vsr:Equipment ;
            owl:onProperty vsr:qualificationForEquipment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass vsr:EquipmentEvidence ;
            owl:onProperty vsr:qualificationSupportedBy ],
        vsr:Assessment .

