<!DOCTYPE rdf:RDF [
     <!ENTITY dc "http://purl.org/dc/elements/1.1/">
     <!ENTITY dct "http://purl.org/dc/terms/">
     <!ENTITY owl "http://www.w3.org/2002/07/owl#">
     <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
     <!ENTITY xml "http://www.w3.org/XML/1998/namespace">
     <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
     <!ENTITY gdmt "https://w3id.org/gdmt/">
     <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
     <!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
     <!ENTITY iof-av "https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">
     <!ENTITY clinops "https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/">
     <!ENTITY cmns-av "https://www.omg.org/spec/Commons/AnnotationVocabulary/">
     <!ENTITY clinops-ref "https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/">
]>
<rdf:RDF xmlns="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/"
     xml:base="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:gdmt="https://w3id.org/gdmt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:clinops="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/"
     xmlns:cmns-av="https://www.omg.org/spec/Commons/AnnotationVocabulary/"
     xmlns:clinops-ref="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/"
     xmlns:iof-av="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">
    <owl:Ontology rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/">
        <owl:imports rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/"/>
        <owl:imports rdf:resource="https://www.w3.org/2004/02/skos/core#"/>
        <dc:created>2024-05-17</dc:created>
        <dct:abstract>This ontology contains reference individuals belonging to classes within the Clinical Trial Operations ontology.</dct:abstract>
        <dct:contributor>Boehringer Ingelheim</dct:contributor>
        <dct:contributor>Crown Point Technologies, LLC</dct:contributor>
        <dct:contributor>Merck KGaA</dct:contributor>
        <dct:contributor>Novartis</dct:contributor>
        <dct:contributor>Pistoia Alliance, Inc.</dct:contributor>
        <dct:contributor>Roche</dct:contributor>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-17</dct:issued>
        <dct:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://opensource.org/licenses/MIT</dct:license>
        <dct:title>Clinical Trial Operations Reference Individuals</dct:title>
        <rdfs:label>Clinical Trial Operations Reference Individuals</rdfs:label>
        <owl:versionIRI>https://spec.pistoiaalliance.org/clinical/ontology/20240517/ClinicalTrialOperationsReferenceIndividuals/</owl:versionIRI>
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <gdmt:sponsor>Boehringer Ingelheim</gdmt:sponsor>
        <gdmt:sponsor>Merck KGaA</gdmt:sponsor>
        <gdmt:sponsor>Novartis</gdmt:sponsor>
        <gdmt:sponsor>Pistoia Alliance, Inc.</gdmt:sponsor>
        <gdmt:sponsor>Roche</gdmt:sponsor>
        <cmns-av:copyright>Copyright (c) 2024 Pistoia Alliance, Inc.</cmns-av:copyright>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/gdmt/sponsor -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/gdmt/sponsor">
        <dct:title>Sponsor</dct:title>
        <rdfs:label>sponsor</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Biomarker -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Biomarker">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/OutcomeComponentType"/>
        <rdfs:label>biomarker</rdfs:label>
        <skos:definition>defined characteristic that is measured as an indicator of normal biological processes, pathogenic processes, or responses to an exposure or intervention, including therapeutic interventions</skos:definition>
        <cmns-av:directSource>https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;ns=ncit&amp;code=C16342</cmns-av:directSource>
        <cmns-av:explanatoryNote>Molecular, histologic, radiographic, or physiologic characteristics are types of biomarkers. A biomarker is not an assessment of how an individual feels, functions, or survives. Categories of biomarkers include: susceptibility/risk biomarker; diagnostic biomarker; monitoring biomarker; prognostic biomarker; predictive biomarker; safety biomarker; pharmacodynamic/response biomarker.</cmns-av:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Efficacy -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Efficacy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/OutcomeComponentType"/>
        <rdfs:label>efficacy</rdfs:label>
        <skos:definition>measure of intended effect on the disease or condition based on adequate and well-controlled clinical trials</skos:definition>
        <cmns-av:directSource>https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;ns=ncit&amp;code=C88183</cmns-av:directSource>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Pharmacokinetic -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Pharmacokinetic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/OutcomeComponentType"/>
        <rdfs:label>pharmacokinetic</rdfs:label>
        <skos:definition>study of the process by which a drug is absorbed, distributed, metabolized, and eliminated by the body</skos:definition>
        <cmns-av:directSource>https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;ns=ncit&amp;code=C49663</cmns-av:directSource>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Phase0Trial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Phase0Trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <rdfs:label>phase 0 trial</rdfs:label>
        <skos:definition>first-in-human trial with a small number of subjects that is conducted before a Phase 1 trial and is intended to assess new candidate therapeutic and imaging agents</skos:definition>
        <cmns-av:adaptedFrom>USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]</cmns-av:adaptedFrom>
        <cmns-av:explanatoryNote>The study agent is administered at a low dose for a limited time, and there is no therapeutic or diagnostic intent. NOTE: FDA Guidance for Industry, Investigators, and Reviewers: Exploratory IND Studies, January 2006 classifies such studies as Phase 1. NOTE: A Phase 0 study might not include any drug delivery but may be an exploration of human material from a study (e.g., tissue samples or biomarker determinations). [Improving the Quality of Cancer Clinical Trials: Workshop summary-Proceedings of the National Cancer Policy Forum Workshop, improving the Quality of Cancer Clinical Trials (Washington, DC, Oct 2007)] (CDISC glossary)</cmns-av:explanatoryNote>
        <cmns-av:synonym>pre-clinical trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 0</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIITrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIITrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <rdfs:label>phase III trial</rdfs:label>
        <skos:definition>expanded controlled and uncontrolled trial that is performed after preliminary evidence suggesting effectiveness of the drug has been obtained, and is intended to gather the additional information about effectiveness and safety that is needed to confirm efficacy and evaluate the overall benefit-risk relationship of the drug and to provide an adequate basis for physician labeling</skos:definition>
        <cmns-av:directSource>https://ncim.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI MetaThesaurus&amp;code=C0282461</cmns-av:directSource>
        <cmns-av:explanatoryNote>Phase 3 studies usually include from several hundred to several thousand subjects. [After FDA CDER Handbook, ICH E8] (CDISC glossary)</cmns-av:explanatoryNote>
        <cmns-av:synonym>phase 3 trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 3</cmns-av:synonym>
        <cmns-av:synonym>trial phase III</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIIaTrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIIaTrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <skos:broader rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIITrial"/>
        <rdfs:label>phase IIIa trial</rdfs:label>
        <skos:definition>classification typically assigned retrospectively to a Phase III trial upon determination by regulatory authorities of a need for a Phase III B trial</skos:definition>
        <cmns-av:directSource>https://ncim.nci.nih.gov/ncimbrowser/ConceptReport.jsp?dictionary=NCI Metathesaurus&amp;code=C1706447</cmns-av:directSource>
        <cmns-av:synonym>phase 3a trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 3a</cmns-av:synonym>
        <cmns-av:synonym>trial phase IIIa</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIIbTrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIIbTrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <skos:broader rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIITrial"/>
        <rdfs:label>phase IIIb trial</rdfs:label>
        <skos:definition>subcategory of Phase III trials done near the time of approval to elicit additional findings</skos:definition>
        <cmns-av:directSource>USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]</cmns-av:directSource>
        <cmns-av:explanatoryNote>Dossier review may continue while associated Phase IIIB trials are conducted. These trials may be required as a condition of regulatory authority approval.</cmns-av:explanatoryNote>
        <cmns-av:synonym>phase 3b trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 3b</cmns-av:synonym>
        <cmns-av:synonym>trial phase IIIb</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIITrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIITrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <rdfs:label>phase II trial</rdfs:label>
        <skos:definition>controlled clinical study conducted to evaluate the effectiveness of the drug for a particular indication or indications in patients with the disease or condition under study and to determine the common short-term side effects and risks associated with the drug</skos:definition>
        <cmns-av:directSource>USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]</cmns-av:directSource>
        <cmns-av:explanatoryNote>NOTE: Phase 2 studies are typically well controlled, closely monitored, and conducted in a relatively small number of patients, usually involving no more than several hundred subjects. [After FDA CDER Handbook, ICH E8] (CDISC glossary)</cmns-av:explanatoryNote>
        <cmns-av:synonym>phase 2 trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 2</cmns-av:synonym>
        <cmns-av:synonym>trial phase II</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIaTrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIaTrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <skos:broader rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIITrial"/>
        <rdfs:label>phase IIa trial</rdfs:label>
        <skos:definition>clinical research protocol generally referred to as a pilot or feasibility trial that aims to prove the concept of the new intervention in question (NCI)</skos:definition>
        <cmns-av:directSource>https://ncim.nci.nih.gov/ncimbrowser/pages/concept_details.jsf?dictionary=NCI MetaThesaurus&amp;code=C1706446&amp;type=properties</cmns-av:directSource>
        <cmns-av:synonym>phase 2a trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 2a</cmns-av:synonym>
        <cmns-av:synonym>trial phase IIa</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIbTrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIIbTrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <skos:broader rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIITrial"/>
        <rdfs:label>phase IIb trial</rdfs:label>
        <skos:definition>clinical research protocol generally referred to as a well-controlled and pivotal trial that aims to prove the mechanism of action of the new intervention in question</skos:definition>
        <cmns-av:directSource>USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]</cmns-av:directSource>
        <cmns-av:explanatoryNote>A pivotal study will generally be well-controlled, randomized, of adequate size, and whenever possible, double-blind. (NCI)</cmns-av:explanatoryNote>
        <cmns-av:synonym>phase 2b trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 2b</cmns-av:synonym>
        <cmns-av:synonym>trial phase IIb</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseITrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseITrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <rdfs:label>phase I trial</rdfs:label>
        <skos:definition>initial introduction of an investigational new drug into humans</skos:definition>
        <cmns-av:directSource>USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]</cmns-av:directSource>
        <cmns-av:explanatoryNote>Phase 1 studies are typically closely monitored and may be conducted in patients or normal volunteer subjects. NOTE: These studies are designed to determine the metabolism and pharmacologic actions of the drug in humans, the side effects associated with increasing doses, and, if possible, to gain early evidence on effectiveness. During Phase 1, sufficient information about the drug&apos;s pharmacokinetics and pharmacological effects should be obtained to permit the design of well-controlled, scientifically valid, Phase 2 studies. The total number of subjects and patients included in Phase I studies varies with the drug, but is generally in the range of 20 to 80. Phase 1 studies also include studies of drug metabolism, structure-activity relationships, and mechanism of action in humans, as well as studies in which investigational drugs are used as research tools to explore biological phenomena or disease processes. [After FDA CDER Handbook, ICH E8] (CDISC glossary)</cmns-av:explanatoryNote>
        <cmns-av:synonym>trial phase 1</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIVTrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseIVTrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <rdfs:label>phase IV trial</rdfs:label>
        <skos:definition>post-approval study to delineate additional information about the drug&apos;s risks, benefits, and optimal use that may be requested by regulatory authorities in conjunction with marketing approval</skos:definition>
        <cmns-av:directSource>USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]</cmns-av:directSource>
        <cmns-av:explanatoryNote>Phase 4 studies could include, but would not be limited to, studying different doses or schedules of administration than were used in Phase 2 studies, use of the drug in other patient populations or other stages of the disease, or use of the drug over a longer period of time. [after FDA CDER handbook, ICH E8] See also phase.</cmns-av:explanatoryNote>
        <cmns-av:synonym>phase 4 trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 4</cmns-av:synonym>
        <cmns-av:synonym>trial phase IV</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseVTrial -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PhaseVTrial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/TrialPhase"/>
        <rdfs:label>phase V trial</rdfs:label>
        <skos:definition>postmarketing surveillance to monitor product safety and efficacy</skos:definition>
        <cmns-av:directSource>USDM [https://github.com/cdisc-org/DDF-RA/tree/main/Deliverables/CT]</cmns-av:directSource>
        <cmns-av:synonym>phase 5 trial</cmns-av:synonym>
        <cmns-av:synonym>trial phase 5</cmns-av:synonym>
        <cmns-av:synonym>trial phase V</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PrimaryEndpoint -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PrimaryEndpoint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/StudyEndpointLevel"/>
        <rdfs:label>primary endpoint</rdfs:label>
        <skos:definition>main result that is measured at the end of a study to see if a given treatment worked (e.g., the number of deaths or the difference in survival between the treatment group and the control group)</skos:definition>
        <cmns-av:directSource>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C94496</cmns-av:directSource>
        <cmns-av:explanatoryNote>What the primary endpoint will be is decided before the study begins. Endpoint(s) of greatest importance that is the basis for concluding whether the study met its objective(s) and provides a clinically relevant, valid, and reliable measure of the primary objective(s). (After FDA-NIH Protocol Template)</cmns-av:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PrimaryObjective -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/PrimaryObjective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/StudyObjectiveLevel"/>
        <rdfs:label>primary objective</rdfs:label>
        <skos:definition>main question to be answered and drives any statistical planning for the trial (e.g., calculation of the sample size to provide the appropriate power for statistical testing)[ICH E6 6.3]</skos:definition>
        <cmns-av:abbreviation>OBJPRIM</cmns-av:abbreviation>
        <cmns-av:directSource>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C85826</cmns-av:directSource>
        <cmns-av:explanatoryNote>A principle objective of the study.</cmns-av:explanatoryNote>
        <cmns-av:synonym>study primary objective</cmns-av:synonym>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Safety -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/Safety">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/OutcomeComponentType"/>
        <rdfs:label>safety</rdfs:label>
        <skos:definition>relative freedom from harm</skos:definition>
        <cmns-av:directSource>https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;ns=ncit&amp;code=C60828</cmns-av:directSource>
        <cmns-av:explanatoryNote>In clinical trials, this refers to an absence of harmful side effects resulting from use of the product and may be assessed by laboratory testing of biological samples, special tests and procedures, psychiatric evaluation, and/or physical examination of subjects.</cmns-av:explanatoryNote>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/SecondaryEndpoint -->

    <owl:NamedIndividual rdf:about="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/SecondaryEndpoint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperations/StudyEndpointLevel"/>
        <rdfs:label>secondary endpoint</rdfs:label>
        <skos:definition>endpoint(s) that may provide supportive information about the effect of the study intervention(s) on the primary endpoint or demonstrate additional effects on the disease or condition (After FDA-NIH Protocol Template)</skos:definition>
        <cmns-av:directSource>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139173</cmns-av:directSource>
    </owl:NamedIndividual>
    


    <!-- https://spec.pistoiaalliance.org/clinical/ontology/ClinicalTrialOperationsReferenceIndividuals/SecondaryObjective -->

