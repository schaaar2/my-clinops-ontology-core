###  https://w3id.org/cdisc/usdm/v4/Abbreviation-abbreviatedText
v4:Abbreviation-abbreviatedText rdf:type owl:DatatypeProperty ;
                                rdfs:domain v4:Abbreviation ;
                                rdfs:range xsd:string ;
