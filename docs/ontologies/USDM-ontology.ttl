###  https://w3id.org/cdisc/usdm/v4/Address-country
v4:Address-country rdf:type owl:ObjectProperty ;
                   rdfs:domain v4:Address ;
                   rdfs:range v4:Code ;
                   rdfs:label "Address-country" ;
                   skos:definition "A sovereign nation occupying a distinct territory and ruled by an autonomous government." ;
                   skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25464> ,
                                   <http://purl.obolibrary.org/obo/NCIT_C25464> ;
                   skos:prefLabel "Country" ;
                   v4:boundCodelistNote "Y (Point out to ISO 3166-1 Alpha-3 Country code)" ;
                   v4:modelName "country" ;
                   v4:modelRepresentation "Attribute" ;
                   v4:relationshipType "Value" .


