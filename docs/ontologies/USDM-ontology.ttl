#    Object Properties
#################################################################

###  https://w3id.org/cdisc/usdm/v4/Abbreviation-extensionAttributes
v4:Abbreviation-extensionAttributes rdf:type owl:ObjectProperty ;
                                    rdfs:domain v4:Abbreviation ;
                                    rdfs:range v4:ExtensionAttribute ;
                                    rdfs:label "Abbreviation-extensionAttributes" ;
                                    v4:relationshipType "Value" .


###  https://w3id.org/cdisc/usdm/v4/Abbreviation-notes
v4:Abbreviation-notes rdf:type owl:ObjectProperty ;
                      rdfs:domain v4:Abbreviation ;
                      rdfs:range v4:CommentAnnotation ;
                      rdfs:label "Abbreviation-notes" ;
                      skos:definition "A brief written record relevant to the abbreviation." ;
                      skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C215570> ,
                                      <http://purl.obolibrary.org/obo/NCIT_C215570> ;
                      skos:prefLabel "Abbreviation Notes" ;
                      v4:modelName "notes" ;
                      v4:modelRepresentation "Attribute" ;
                      v4:relationshipType "Value" .


###  https://w3id.org/cdisc/usdm/v4/Activity-bcCategoryIds
v4:Activity-bcCategoryIds rdf:type owl:ObjectProperty ;
                          rdfs:domain v4:Activity ;
                          rdfs:range v4:BiomedicalConceptCategory ;
                          rdfs:label "Activity-bcCategoryIds" ;
                          skos:definition "A USDM relationship between the Activity and BiomedicalConceptCategory classes which identifies the set of biomedical concept categories associated with the activity." ;
                          v4:modelName "bcCategories" ;
                          v4:modelRepresentation "Relationship" ;
                          v4:relationshipType "Ref" .


###  https://w3id.org/cdisc/usdm/v4/Activity-bcSurrogateIds
v4:Activity-bcSurrogateIds rdf:type owl:ObjectProperty ;
                           rdfs:domain v4:Activity ;
                           rdfs:range v4:BiomedicalConceptSurrogate ;
                           rdfs:label "Activity-bcSurrogateIds" ;
                           skos:definition "A USDM relationship between the Activity and BiomedicalConceptSurrogate classes which identifies the set of biomedical concept surrogates associated with the activity." ;
                           v4:modelName "bcSurrogates" ;
                           v4:modelRepresentation "Relationship" ;
                           v4:relationshipType "Ref" .


###  https://w3id.org/cdisc/usdm/v4/Activity-biomedicalConceptIds
v4:Activity-biomedicalConceptIds rdf:type owl:ObjectProperty ;
                                 rdfs:domain v4:Activity ;
                                 rdfs:range v4:BiomedicalConcept ;
                                 rdfs:label "Activity-biomedicalConceptIds" ;
                                 skos:definition "A USDM relationship between the Activity and BiomedicalConcept classes which identifies the set of biomedical concepts associated with the activity." ;
                                 v4:modelName "biomedicalConcepts" ;
                                 v4:modelRepresentation "Relationship" ;
                                 v4:relationshipType "Ref" .


###  https://w3id.org/cdisc/usdm/v4/Activity-childIds
v4:Activity-childIds rdf:type owl:ObjectProperty ;
                     rdfs:domain v4:Activity ;
                     rdfs:range v4:Activity ;
                     rdfs:label "Activity-childIds" ;
                     skos:definition "A USDM relationship within the Activity class which identifies the set of child activities associated with an activity." ;
                     v4:modelName "children" ;
                     v4:modelRepresentation "Relationship" ;
                     v4:relationshipType "Ref" .


###  https://w3id.org/cdisc/usdm/v4/Activity-definedProcedures
v4:Activity-definedProcedures rdf:type owl:ObjectProperty ;
                              rdfs:domain v4:Activity ;
                              rdfs:range v4:Procedure ;
                              rdfs:label "Activity-definedProcedures" ;
                              skos:definition "A USDM relationship between the Activity and Procedure classes which identifies the set of defined procedures associated with the activity." ;
                              v4:modelName "definedProcedures" ;
                              v4:modelRepresentation "Relationship" ;
                              v4:relationshipType "Value" .


###  https://w3id.org/cdisc/usdm/v4/Activity-extensionAttributes
v4:Activity-extensionAttributes rdf:type owl:ObjectProperty ;
