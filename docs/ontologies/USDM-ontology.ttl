###  https://w3id.org/cdisc/usdm/v4/Abbreviation
v4:Abbreviation rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty v4:Abbreviation-abbreviatedText ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty v4:Abbreviation-expandedText ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty v4:Abbreviation-id ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty v4:Abbreviation-instanceType ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                rdfs:label "Abbreviation" ;
                skos:definition "A set of letters that are drawn from a word or from a sequence of words and that are used for brevity in place of the full word or phrase. (CDISC Glossary)" ;
                skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42610> ,
                                <http://purl.obolibrary.org/obo/NCIT_C42610> ;
                skos:prefLabel "Abbreviation" ;
                v4:modifier "Concrete" .


