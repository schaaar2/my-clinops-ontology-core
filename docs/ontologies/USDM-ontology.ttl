                                                               <http://purl.obolibrary.org/obo/NCIT_C66726> ;
                                              v4:boundCodelistNote "Y (SDTM Terminology Codelist C66726)" ;
                                              v4:modelName "administrableDoseForm" ;
                                              v4:modelRepresentation "Attribute" ;
                                              v4:relationshipType "Value" .


