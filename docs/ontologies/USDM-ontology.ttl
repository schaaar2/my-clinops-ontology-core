###  https://w3id.org/cdisc/usdm/v4/Activity-nextId
v4:Activity-nextId rdf:type owl:ObjectProperty ;
                   rdfs:domain v4:Activity ;
                   rdfs:range v4:Activity ;
                   rdfs:label "Activity-nextId" ;
                   skos:definition "A USDM relationship within the Activity class which identifies the activity that follows the current activity in the display order." ;
                   v4:modelName "next" ;
                   v4:modelRepresentation "Relationship" ;
                   v4:relationshipType "Ref" .


###  https://w3id.org/cdisc/usdm/v4/Activity-notes
v4:Activity-notes rdf:type owl:ObjectProperty ;
                  rdfs:domain v4:Activity ;
                  rdfs:range v4:CommentAnnotation ;
                  rdfs:label "Activity-notes" ;
                  skos:definition "A brief written record relevant to the activity." ;
                  skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C215519> ,
                                  <http://purl.obolibrary.org/obo/NCIT_C215519> ;
                  skos:prefLabel "Activity Notes" ;
                  v4:modelName "notes" ;
                  v4:modelRepresentation "Attribute" ;
                  v4:relationshipType "Value" .


###  https://w3id.org/cdisc/usdm/v4/Activity-previousId
v4:Activity-previousId rdf:type owl:ObjectProperty ;
                       rdfs:domain v4:Activity ;
                       rdfs:range v4:Activity ;
                       rdfs:label "Activity-previousId" ;
                       skos:definition "A USDM relationship within the Activity class which identifies the activity that precedes the current activity in the display order." ;
                       v4:modelName "previous" ;
                       v4:modelRepresentation "Relationship" ;
                       v4:relationshipType "Ref" .


###  https://w3id.org/cdisc/usdm/v4/Activity-timelineId
v4:Activity-timelineId rdf:type owl:ObjectProperty ;
                       rdfs:domain v4:Activity ;
                       rdfs:range v4:ScheduleTimeline ;
                       rdfs:label "Activity-timelineId" ;
                       skos:definition "A USDM relationship between the Activity and ScheduleTimeline classes which provides the details associated with an instance of the scheduled timeline related to the activity." ;
                       v4:modelName "timeline" ;
                       v4:modelRepresentation "Relationship" ;
