###  https://w3id.org/cdisc/usdm/v4/Endpoint
v4:Endpoint rdf:type owl:Class ;
            rdfs:subClassOf v4:SyntaxTemplate ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Endpoint-level ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Endpoint-instanceType ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Endpoint-purpose ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ;
            rdfs:label "Endpoint" ;
            skos:definition "A defined variable intended to reflect an outcome of interest that is statistically analyzed to address a particular research question. NOTE: A precise definition of an endpoint typically specifies the type of assessments made, the timing of those assessments, the assessment tools used, and possibly other details, as applicable, such as how multiple assessments within an individual are to be combined. [After BEST Resource] (CDISC Glossary)" ;
            skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25212> ,
                            <http://purl.obolibrary.org/obo/NCIT_C25212> ;
            skos:prefLabel "Study Endpoint" ;
            v4:modifier "Concrete" .


###  https://w3id.org/cdisc/usdm/v4/Estimand
v4:Estimand rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-intercurrentEvents ;
                              owl:minCardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-interventionIds ;
                              owl:minCardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-analysisPopulationId ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-variableOfInterestId ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-id ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-instanceType ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-name ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-populationSummary ;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-description ;
                              owl:maxCardinality "1"^^xsd:nonNegativeInteger
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty v4:Estimand-label ;
                              owl:maxCardinality "1"^^xsd:nonNegativeInteger
                            ] ;
            rdfs:label "Estimand" ;
            skos:definition "A precise description of the treatment effect reflecting the clinical question posed by a given clinical trial objective. It summarises at a population level what the outcomes would be in the same patients under different treatment conditions being compared. (ICH E9 R1 Addendum)" ;
            skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C188813> ,
                            <http://purl.obolibrary.org/obo/NCIT_C188813> ;
            skos:prefLabel "Estimand" ;
            v4:modifier "Concrete" .


