v4:Administration-dose rdf:type owl:ObjectProperty ;
                       rdfs:domain v4:Administration ;
                       rdfs:range v4:Quantity ;
                       rdfs:label "Administration-dose" ;
                       skos:definition "The value representing the amount of an agent given to an individual at one time." ;
                       skos:exactMatch <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C167190> ,
                                       <http://purl.obolibrary.org/obo/NCIT_C167190> ;
                       skos:prefLabel "Administration Dose" ;
                       v4:modelName "dose" ;
                       v4:modelRepresentation "Attribute" ;
                       v4:relationshipType "Value" .


