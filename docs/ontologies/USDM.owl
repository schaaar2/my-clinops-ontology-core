    <!-- https://w3id.org/cdisc/usdm/v4/AdministrableProduct-administrableDoseForm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cdisc/usdm/v4/AdministrableProduct-administrableDoseForm">
        <rdfs:domain rdf:resource="https://w3id.org/cdisc/usdm/v4/AdministrableProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/cdisc/usdm/v4/AliasCode"/>
        <rdfs:label>AdministrableProduct-administrableDoseForm</rdfs:label>
        <skos:definition>The physical form in which formulated ingredient(s) are presented in the administrable product.</skos:definition>
        <skos:exactMatch rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C215576"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C215576"/>
        <skos:prefLabel>Administrable Product Dose Form</skos:prefLabel>
        <boundCodelist rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C66726"/>
        <boundCodelist rdf:resource="http://purl.obolibrary.org/obo/NCIT_C66726"/>
        <boundCodelistNote>Y (SDTM Terminology Codelist C66726)</boundCodelistNote>
        <modelName>administrableDoseForm</modelName>
        <modelRepresentation>Attribute</modelRepresentation>
        <relationshipType>Value</relationshipType>
    </owl:ObjectProperty>
    


