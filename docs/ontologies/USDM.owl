    <owl:ObjectProperty rdf:about="https://w3id.org/cdisc/usdm/v4/Activity-childIds">
        <rdfs:domain rdf:resource="https://w3id.org/cdisc/usdm/v4/Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/cdisc/usdm/v4/Activity"/>
        <rdfs:label>Activity-childIds</rdfs:label>
