                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label>Condition-appliesToIds</rdfs:label>
        <skos:definition>A USDM relationship between the Condition and the Activity, Procedure, BiomedicalConcept, BiomedicalConceptSurrogate, or BiomedicalConceptCategory classes which identifies the procedure, activity, biomedical concept, biomedical concept surrogate, or biomedical concept category that applies to the condition.</skos:definition>
        <modelName>appliesTo</modelName>
        <modelRepresentation>Relationship</modelRepresentation>
        <relationshipType>Ref</relationshipType>
    </owl:ObjectProperty>
    


