        <rdfs:label>StudyDesign-therapeuticAreas</rdfs:label>
        <skos:definition>A categorization of a disease, disorder, or other condition based on common characteristics and often associated with a medical specialty focusing on research and development of specific therapeutic interventions for the purpose of treatment and prevention, which is associated with the interventional study design.</skos:definition>
        <skos:exactMatch rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C215633"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C215633"/>
        <skos:prefLabel>Interventional Study Design Therapeutic Areas</skos:prefLabel>
        <boundCodelistNote>Y (Point out to external dictionaries)</boundCodelistNote>
        <modelName>therapeuticAreas</modelName>
        <modelRepresentation>Attribute</modelRepresentation>
        <relationshipType>Value</relationshipType>
    </owl:ObjectProperty>
    


