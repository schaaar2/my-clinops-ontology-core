            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cdisc/usdm/v4/Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/cdisc/usdm/v4/BiomedicalConcept"/>
