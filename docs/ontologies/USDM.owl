        <rdfs:range rdf:resource="https://w3id.org/cdisc/usdm/v4/Code"/>
        <rdfs:label>Address-country</rdfs:label>
        <skos:definition>A sovereign nation occupying a distinct territory and ruled by an autonomous government.</skos:definition>
        <skos:exactMatch rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25464"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25464"/>
        <skos:prefLabel>Country</skos:prefLabel>
        <boundCodelistNote>Y (Point out to ISO 3166-1 Alpha-3 Country code)</boundCodelistNote>
        <modelName>country</modelName>
        <modelRepresentation>Attribute</modelRepresentation>
        <relationshipType>Value</relationshipType>
    </owl:ObjectProperty>
    


