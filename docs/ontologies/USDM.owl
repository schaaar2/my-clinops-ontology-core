    <owl:ObjectProperty rdf:about="https://w3id.org/cdisc/usdm/v4/AdministrableProduct-identifiers">
        <rdfs:domain rdf:resource="https://w3id.org/cdisc/usdm/v4/AdministrableProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/cdisc/usdm/v4/AdministrableProductIdentifier"/>
        <rdfs:label>AdministrableProduct-identifiers</rdfs:label>
        <skos:definition>A USDM relationship between the AdministrableProduct and AdministrableProductIdentifier classes which provides the set of identifiers related to the administrable product.</skos:definition>
        <modelName>identifiers</modelName>
        <modelRepresentation>Relationship</modelRepresentation>
        <relationshipType>Value</relationshipType>
    </owl:ObjectProperty>
    


