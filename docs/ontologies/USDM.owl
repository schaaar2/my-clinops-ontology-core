    <!-- https://w3id.org/cdisc/usdm/v4/AdministrableProduct-pharmacologicClass -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cdisc/usdm/v4/AdministrableProduct-pharmacologicClass">
        <rdfs:domain rdf:resource="https://w3id.org/cdisc/usdm/v4/AdministrableProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/cdisc/usdm/v4/Code"/>
        <rdfs:label>AdministrableProduct-pharmacologicClass</rdfs:label>
        <skos:definition>The pharmacological class of the administrable product.</skos:definition>
        <skos:exactMatch rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C215577"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C215577"/>
        <skos:prefLabel>Administrable Product Pharmacologic Class</skos:prefLabel>
        <boundCodelistNote>Y (Points to external codelists such as UNII, MED-RT)</boundCodelistNote>
        <modelName>pharmacologicClass</modelName>
        <modelRepresentation>Attribute</modelRepresentation>
        <relationshipType>Value</relationshipType>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdisc/usdm/v4/AdministrableProduct-productDesignation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cdisc/usdm/v4/AdministrableProduct-productDesignation">
        <rdfs:domain rdf:resource="https://w3id.org/cdisc/usdm/v4/AdministrableProduct"/>
        <rdfs:range rdf:resource="https://w3id.org/cdisc/usdm/v4/Code"/>
        <rdfs:label>AdministrableProduct-productDesignation</rdfs:label>
        <skos:definition>An indication as to whether the administrable product is an investigational medicinal product or an auxiliary medicinal product.</skos:definition>
        <skos:exactMatch rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C215579"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C215579"/>
        <skos:prefLabel>Administrable Product Product Designation</skos:prefLabel>
        <boundCodelist rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C207418"/>
        <boundCodelist rdf:resource="http://purl.obolibrary.org/obo/NCIT_C207418"/>
