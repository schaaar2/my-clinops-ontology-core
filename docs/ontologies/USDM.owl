    <!-- https://w3id.org/cdisc/usdm/v4/Endpoint -->


    <owl:Class rdf:about="https://w3id.org/cdisc/usdm/v4/Endpoint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdisc/usdm/v4/SyntaxTemplate"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdisc/usdm/v4/Endpoint-level"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdisc/usdm/v4/Endpoint-instanceType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdisc/usdm/v4/Endpoint-purpose"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Endpoint</rdfs:label>
        <skos:definition>A defined variable intended to reflect an outcome of interest that is statistically analyzed to address a particular research question. NOTE: A precise definition of an endpoint typically specifies the type of assessments made, the timing of those assessments, the assessment tools used, and possibly other details, as applicable, such as how multiple assessments within an individual are to be combined. [After BEST Resource] (CDISC Glossary)</skos:definition>
        <skos:exactMatch rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25212"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25212"/>
        <skos:prefLabel>Study Endpoint</skos:prefLabel>
